#!/usr/bin/env bats

load fixture

export TEST=khal-streak=sortNewestAndShortestFirst

@test "events are sorted by newest first" {
    run -0 khal-streak <<'EOF'
2025-01-12 16:30	2025-01-12 17:30
2026-08-27 08:00	2026-08-27 09:00
2026-08-27 09:00	2026-08-27 10:00
2026-09-15 08:00	2026-09-15 09:00
EOF
    assert_output - <<'EOF'
2026-09-15 08:00	2026-09-15 09:00
2026-08-27 09:00	2026-08-27 10:00
2026-08-27 08:00	2026-08-27 09:00
2025-01-12 16:30	2025-01-12 17:30
EOF
}

@test "events ending at the same time are sorted by shortest first" {
    run -0 khal-streak <<'EOF'
2026-08-27 08:00	2026-08-27 10:00
2026-08-27 08:30	2026-08-27 10:00
2026-08-27 09:00	2026-08-27 10:00
EOF
    assert_output - <<'EOF'
2026-08-27 09:00	2026-08-27 10:00
2026-08-27 08:30	2026-08-27 10:00
2026-08-27 08:00	2026-08-27 10:00
EOF
}

@test "overlapping events are sorted by newest and shortest first" {
    run -0 khal-streak <<'EOF'
2025-01-12 16:30	2025-01-12 17:30
2026-08-27 08:00	2026-08-27 09:00
2026-08-27 08:15	2026-08-27 09:30
2026-08-27 08:30	2026-08-27 09:45
2026-08-27 09:00	2026-08-27 10:00
2026-09-15 08:00	2026-09-15 09:00
EOF
    assert_output - <<'EOF'
2026-09-15 08:00	2026-09-15 09:00
2026-08-27 09:00	2026-08-27 10:00
2026-08-27 08:30	2026-08-27 09:45
2026-08-27 08:15	2026-08-27 09:30
2026-08-27 08:00	2026-08-27 09:00
2025-01-12 16:30	2025-01-12 17:30
EOF
}
