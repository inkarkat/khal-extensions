#!/bin/bash

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: [KHAL_TALLY_what_FACTOR=N [KHAL_TALLY_what_UNIT=UNIT] ...] %q %s\n' "$(basename "$1")" '[-i|--individual-numbers [--raw-dates]|-y|--summary-only|-Y|--no-summary|--print-whats] [--unit UNIT-PATTERN] "WHAT-PATTERN [CONTEXT ...]" [KHAL-ARGS ...] [-?|-h|--help]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Show all events whose title matches WHAT-PATTERN [NUMBER UNIT] [CONTEXT ...].
WHAT-PATTERN is a grep-style anchored basic regular expression.
If there are NUMBER(s), extract all for each UNIT and show their sums.
For events without NUMBER(s), their durations (in seconds) can be converted into
UNIT-equivalents via the KHAL_TALLY_what_FACTOR and KHAL_TALLY_what_UNIT
environment variables, where "what" is replaced by WHAT-PATTERN matches.
Print a summary of the total duration and date range in which they were
scheduled.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --individual-numbers|-i
			Output individual events with their NUMBERs instead of
			summing them up.
    --summary-only|-y	Do not output the sum(s); just show the total effort and
			date range.
    --no-summary|-Y	Just output the sum(s) without total effort and date
			range at the end.
    --unit UNIT-PATTERN	Just show WHAT-PATTERN matches where the passed
			UNIT-PATTERN matches; ignore all other units.
			Applies to both NUMBER(s) and durations converted to
			UNIT-equivalents.
HELPTEXT
}

rcFilespec="${XDG_CONFIG_HOME:-${HOME}/.config}/khal/env"; [ ! -f "$rcFilespec" ] || source "$rcFilespec" || exit $?; export "${!KHAL_@}"

tallyFieldNr=1
typeset -a numberProcessing=(--process 'sumField --group-by 6 --result-first 5')
typeset -a nonNumberProcessing=(--process 'sumField --group-by 4 --result-first 3')
isShowSums=t
isSummary=t
isPrintWhats=
summaryNumberUnitMulti='\?'
filterUnit=
typeset -a rawDatesArg=()
typeset -a filterUnitProcessing=()
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--no-color|--color)
			shift;;	# Ignore color flag; tally doesn't use highlighting.
	--individual-numbers|-i)
			shift; tallyFieldNr=3; numberProcessing=(--process 'field 1 2 5 6'); nonNumberProcessing=();;
	--summary-only|-y)
			shift; isShowSums=;;
	--no-summary|-Y)
			shift; isSummary=;;
	--print-whats)	shift; isPrintWhats=t; isShowSums=; isSummary=;;
	--unit)		shift; filterUnit="${1:?}"; filterUnitProcessing=(--process "grep '[[:space:]]\\(${1}\\)\$'"); shift; summaryNumberUnitMulti='';;
	--raw-dates)	rawDatesArg+=("$1"); shift;;
	--)		shift; break;;
	*)		break;;
    esac
done
if [ ${#rawDatesArg[@]} -gt 0 ]; then
    if [ ${#nonNumberProcessing[@]} -gt 0 ]; then
	echo 'ERROR: --raw-dates can only be used in combination with -i|--individual-numbers.'
	echo
	printUsage "$0"
	exit 2
    fi

    numberProcessing=(--process 'field 1 2 3 4 6 7')	# Raw end date takes up two fields instead of one for the duration.

    # The non-number processing is complicated, as use of khal-grep --raw-dates
    # precludes the use of reldate to calculate durations, so we have to do it
    # ourselves. First, move the WHAT-PATTERN field one to the right, and fill that
    # position with the calculated start date + duration. The following pipeline
    # step then removes the duplicate start date and anything after the
    # WHAT-PATTERN.
    nonNumberProcessing=(
	--process "fieldMap 6 '\$5' 5 '\$1 \" \" \$2 \" \" \$3 \" \" \$4|reldate --unbuffered --relative-to-first --difference'"
	--process "field 1 2 3 4 7 8"
    )
    let tallyFieldNr+=2
fi >&2
if [[ "$1" =~ ^([^[:space:]]+)[[:space:]]+(.*)$ ]]; then
    what="${BASH_REMATCH[1]}"
    context="${BASH_REMATCH[2]:+ }${BASH_REMATCH[2]}"
else
    what="${1:?}"
    context='\([[:space:]].*\)\?'
fi; shift

getMatchExpr()
{
    local numberUnitMulti="${1?}"; shift
    printf %s "^\\(${what}\\)\\( [[:digit:]]\\+ \\(${filterUnit:-[[:alpha:]]\\+}\\)\\)${numberUnitMulti}${context}\$"
}

: ${KHAL_RANGE_START=1970-01-01}; : ${KHAL_RANGE_END=2099-12-31}; export KHAL_RANGE_START KHAL_RANGE_END

printf -v quotedEnvFactorFunction %q 'envFactor(fieldNr,      factor) {
    factor = ENVIRON["KHAL_TALLY_" toupper($(fieldNr + 1)) "_FACTOR"]
    return factor == "" ? 0 : $fieldNr * factor
}'
printf -v quotedEnvUnitFunction %q 'envUnit(fieldNr,      unit) {
    unit = ENVIRON["KHAL_TALLY_" toupper($(fieldNr + 1)) "_UNIT"]
    return unit == "" ? $(fieldNr + 1) "-units" : unit
}'

if [ "$isShowSums" ]; then
    # With NUMBER UNIT: Group by UNIT, sum NUMBERs for all WHAT-PATTERNs together.
    khal-grep --no-color --once --no-summary "${rawDatesArg[@]}" \
	"${numberProcessing[@]}" \
	-e "$(getMatchExpr '')" \
	"$@"

    # Without NUMBER UNIT: Group by WHAT-PATTERN, sum durations in seconds, and
    # convert to UNIT-equivalents.
    khal-grep --no-color --once --no-summary "${rawDatesArg[@]}" \
	"${nonNumberProcessing[@]}" \
	--process "fieldMap --function $quotedEnvFactorFunction --function $quotedEnvUnitFunction --filter 'envFactor($tallyFieldNr)' $tallyFieldNr 'envFactor($tallyFieldNr)' $((tallyFieldNr + 1)) 'envUnit($tallyFieldNr)'" \
	"${filterUnitProcessing[@]}" \
	-e "$(getMatchExpr '\{0\}')" \
	"$@"
fi
if [ "$isPrintWhats" ]; then
    khal-grep --no-color --once --no-summary \
	--process 'field 4' \
	--process 'sort --unique' \
	-e "$(getMatchExpr "$summaryNumberUnitMulti")" \
	"$@"
fi
if [ "$isSummary" ]; then
    khal-grep --no-color --once --summary-only \
	-e "$(getMatchExpr "$summaryNumberUnitMulti")" \
	"$@"
fi
